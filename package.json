{
  "name": "karman-wind-tunnel",
  "private": true,
  "version": "1.0.0",
  "description": "Draw any shape into a live lattice-Boltzmann wind tunnel and measure the drag, lift and vortex shedding it causes.",
  "type": "module",
  "license": "MIT",
  "author": "Mustafa Obaid",
  "homepage": "https://mustafaobaidd1.github.io/karman-wind-tunnel/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaobaidd1/karman-wind-tunnel.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build && npm run test:e2e",
    "validate": "node scripts/validate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "katex": "^0.19.0"
  }
}
